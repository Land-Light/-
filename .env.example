# オフィスステーション勤怠の認証情報・接続先
# このファイルを .env にコピーして値を埋めてください（.env は git 管理外）

# 管理画面の入口URL（トークン付きURL。秘密情報として扱う）
OFS_ADMIN_URL=https://attendance.officestation.jp/admin/8UXpQqNNyRqaxGbyODPtSiYx79len7Do

# ログイン情報
OFS_LOGIN_ID=
OFS_PASSWORD=

# ブラウザ表示（true=画面を表示しながら実行 / false=ヘッドレス）
# 最初はデバッグしやすいよう true 推奨
HEADFUL=true

# 実行間の待機ミリ秒（サーバ負荷・取りこぼし対策）
ACTION_DELAY_MS=800
