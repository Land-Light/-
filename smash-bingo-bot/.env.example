# LINE Developers → Messaging APIチャネル → 「Messaging API設定」
LINE_CHANNEL_ACCESS_TOKEN=ここに長期のチャネルアクセストークンを貼る

# 同じチャネルの「チャネル基本設定」にある Channel secret
LINE_CHANNEL_SECRET=ここにチャネルシークレットを貼る

# 任意: 画像URLの組み立て方を固定したいときだけ設定する
# （ふだんはリクエストのヘッダーから自動で判断します）
# BASE_URL=https://example.com

# 任意: ビンゴの一辺のマス数（既定 5）
# BINGO_SIZE=5

# 任意: 日本語フォントのパス（既定ではOSの標準フォントを探します）
# BINGO_FONT=/usr/share/fonts/opentype/ipafont-gothic/ipagp.ttf
