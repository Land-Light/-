{
  "name": "officestation-schedule-bot",
  "version": "0.1.0",
  "description": "オフィスステーション勤怠のスケジュール申請（日々の出勤/退勤時刻）を自動化するツール",
  "type": "module",
  "scripts": {
    "ui": "node src/server.js",
    "apply": "node src/index.js",
    "apply:dry": "node src/index.js --dry-run",
    "dump": "node src/dumpPage.js",
    "codegen": "playwright codegen",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  }
}
