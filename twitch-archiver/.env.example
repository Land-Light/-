# 監視する Twitch チャンネル
TWITCH_CHANNEL=paseriman2

# 録画画質 (best / 1080p60 / 720p60 など)
QUALITY=best

# 配信中か確認する間隔 (秒)
POLL_INTERVAL=60
# 回線切れなどで途切れても、この秒数以内に再開すれば同じ配信としてまとめる
RECONNECT_GRACE=300

# 日付の表示に使うタイムゾーン (日本時間 = 9)
TZ_OFFSET_HOURS=9

# YouTube のタイトル・説明文 ({title} {category} {date} {datetime} {channel} が使えます)
TITLE_TEMPLATE={title} 【{date}】
# 説明文の改行は \n と書きます
# DESCRIPTION_TEMPLATE=配信タイトル: {title}\nhttps://www.twitch.tv/{channel}
TAGS=Twitch,配信アーカイブ

# 公開設定: private / unlisted / public
PRIVACY=private
# YouTube のカテゴリ (20 = ゲーム, 22 = ブログ, 24 = エンターテイメント)
CATEGORY_ID=20
MADE_FOR_KIDS=false
# 追加する再生リストの ID (空なら追加しない)
PLAYLIST_ID=

# アップロードが終わったら手元の動画を消す
DELETE_AFTER_UPLOAD=true
# これより長い動画は分割する (YouTube の上限は 12 時間)
MAX_VIDEO_HOURS=11.5

# false にすると録画だけ行う
UPLOAD_ENABLED=true

# (任意) Twitch のログイン済みブラウザの auth-token Cookie。
# サブスク済みなら広告なしで録画できます
TWITCH_OAUTH_TOKEN=
